    "@typescript-eslint/parser": "^8.50.1",
    "d3-array": "^3.2.4",
    "d3-axis": "^3.0.0",
    "d3-drag": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
