    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "typedoc",
    "docs:json": "node scripts/generate-docs.mjs",
    "release": "nx release --skip-publish",
    "release:dry-run": "nx release --dry-run"
  },
  "dependencies": {
    "tslib": "^2.8.1",
    "uuid": "^13.0.2"
  },
  "devDependencies": {
