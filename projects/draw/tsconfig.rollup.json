{
  "extends": "./tsconfig.lib.json",
  "compilerOptions": {
    "module": "esnext",
    "target": "es2020",
    "importHelpers": false,
    "moduleResolution": "bundler",
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "incremental": false,
    "emitDeclarationOnly": false,
    "noEmit": false,
    "outDir": "../../dist/projects/draw",
    "rootDir": "../..",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "../../libs/common/src/**/*.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "../../libs/common/src/**/*.spec.ts",
    "../../libs/common/src/**/*.test.ts",
    "jest.config.ts"
  ]
}
